# koneps_ai_project 배포 환경변수 예시
# 서버에서 cp .env.example .env  후 값을 채워서 사용

# ─────────────────────────────
# DB (postgres 컨테이너)
# ─────────────────────────────
POSTGRES_USER=koneps
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=koneps

# ─────────────────────────────
# 인증
# ─────────────────────────────
# openssl rand -hex 32  로 32바이트 랜덤 hex 생성 권장
JWT_SECRET_KEY=replace-with-random-32-bytes-hex

# ─────────────────────────────
# 외부 API 키
# ─────────────────────────────
G2B_API_KEY=your-g2b-open-api-key
LIBREAI_API_KEY=your-libreai-api-key
GEMINI_API_KEY=your-google-gemini-api-key

# 선택: 모델/엔드포인트 오버라이드
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_FALLBACK_MODEL=gemini-2.5-pro
# LIBREAI_API_URL=https://convert.liberoai.net/api

# ─────────────────────────────
# CORS — 운영 시엔 와일드카드 대신 정확한 origin으로 좁히길 권장
# 예: CORS_ORIGINS=http://203.0.113.10,http://koneps.example.com
# ─────────────────────────────
CORS_ORIGINS=*

# ─────────────────────────────
# 포트 (호스트에 노출할 외부 포트 — 보통 80)
# ─────────────────────────────
WEB_PORT=80
